# Copier ce fichier en `.env` puis adapter. Le fichier .env ne doit JAMAIS être commité.

# --- API NexaPay simulée (mock_api) ---
NEXA_API_BASE_URL=http://127.0.0.1:8000
NEXA_API_CLIENT_ID=etudiant-de
NEXA_API_CLIENT_SECRET=change-me-s3cret
# Comportement "chaos" de l'API : proportion de réponses 503 aléatoires (0 à 1)
NEXA_API_CHAOS_RATE=0.08
# Limite de débit : nombre de requêtes autorisées par fenêtre de 2 secondes
NEXA_API_RATE_LIMIT=8

# --- Bases de données ---
# Par défaut : SQLite dans ./data (aucune installation nécessaire)
# Variante PostgreSQL installé en local (sans Docker) :
# WAREHOUSE_DB_URL=postgresql+psycopg://nexa:nexa@localhost:5432/nexa_dwh
# SOURCE_DB_URL=sqlite:///data/sources/core_banking.db

# --- RGPD : clé de pseudonymisation (HMAC-SHA256) ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
PSEUDO_SECRET_KEY=remplacer-par-une-cle-aleatoire-de-64-caracteres-hex

# --- Streaming (Jour 3) ---
# "simulator" (aucune installation) ou "kafka" (broker Kafka local)
STREAM_BACKEND=simulator
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
