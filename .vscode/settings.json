{
    // Python de l'environnement « data » (scripts des TP et du projet intégré)
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    // Tests du projet intégré, lancés depuis la racine (comme en ligne de commande)
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["jour3/projet_integre/tests"],
    // Fichiers générés : inutile de les afficher ni de les indexer
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/.venv-airflow/**": true,
        "**/airflow_home/**": true,
        "**/.dvc/cache/**": true
    }
}
